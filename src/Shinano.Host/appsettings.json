{
  "AllowedHosts": "*",
  "Shinano": {
    "Deployment": {
      "TimeZone": "Asia/Shanghai",
      "BucketPrefix": "shinano"
    },
    "LlBot": {
      "Host": "127.0.0.1",
      "Port": 3000
    },
    "Plugins": {
      "Directory": "plugins"
    },
    "RustFs": {
      "PresignExpiryMinutes": 10
    },
    "Media": {
      "MaxFileSizeMiB": 100,
      "OrphanGraceHours": 24
    },
    "ChatArchive": {
      "RetentionDays": 30,
      "PartitionDaysAhead": 3
    },
    "Logging": {
      "MinimumLevel": "Information",
      "MaxTotalSizeMiB": 2048
    },
    "Web": {
      "ListenAddress": "127.0.0.1",
      "Port": 19100
    },
    "Rendering": {
      "Width": 1200
    },
    "Restart": {
      "KeepBackup": true
    },
    "Monitor": {
      "ListenAddress": "127.0.0.1",
      "Port": 19101,
      "IntervalSeconds": 30,
      "MaxLogSizeMiB": 256
    }
  }
}
