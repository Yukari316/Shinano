<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <!-- 插件按插件包目录布局输出到 artifacts/plugins/<工程名>/，宿主的插件目录可直接指向 artifacts/plugins。 -->
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../artifacts/plugins/$(MSBuildProjectName)/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 共享类库（如 Shinano.Plugin.ImageSources）没有 plugin.json，不是插件包。 -->
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('plugin.json')"/>
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="web/**" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
